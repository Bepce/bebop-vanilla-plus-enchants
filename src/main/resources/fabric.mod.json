{
	"schemaVersion": 1,
	"id": "bebop-vanilla-plus-enchants",
	"version": "${version}",
	"name": "Bebop Vanilla Plus Enchants",
	"description": "Vanilla+ enchantments you have to find, not buy. Strip Mining mines whole ore veins, Felling chops down whole trees. Found in mineshafts, dungeons, ancient cities and trial chamber vaults.",
	"authors": [
		"Bepce"
	],
	"contact": {
		"homepage": "https://github.com/Bepce/Bebop-Vanilla-Plus-Enchants",
		"sources": "https://github.com/Bepce/Bebop-Vanilla-Plus-Enchants",
		"issues": "https://github.com/Bepce/Bebop-Vanilla-Plus-Enchants/issues"
	},
	"license": "MIT",
	"icon": "assets/bebop-vanilla-plus-enchants/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"me.bebopenchants.BebopVanillaPlusEnchants"
		],
		"client": [
			"me.bebopenchants.client.BebopVanillaPlusEnchantsClient"
		]
	},
	"mixins": [
		"bebop-vanilla-plus-enchants.mixins.json",
		{
			"config": "bebop-vanilla-plus-enchants.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}